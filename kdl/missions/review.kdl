// Review each new pull request with evidence.
version 2
mission "github/review" state="ready" \
    timeout="2h" report-to="agent/github/reviewer" {
  goal "The PR has an evidence-backed review."
  constraint "Review only. Never approve or merge."
  // The subscription passes the pull request it saw
  input "source" kind="resource"
  // Tests and context run side by side
  step "reproduce" timeout="20m" {
    assigned-to "agent/github/tester"
    goal "Run the tests of ${input.source}."
  }
  step "context" timeout="15m" {
    assigned-to "agent/github/reviewer"
    goal "Find the issues behind ${input.source}."
  }
  step "review" timeout="30m" {
    assigned-to "agent/github/reviewer"
    depends-on {
      step "reproduce" completed
      step "context" completed
    }
    goal "Publish findings with evidence."
    gate "review published" {
      document "doc/github/review"
    }
  }
  // No answer in time fails it as unsigned
  step "sign-off" timeout="30m" {
    depends-on {
      step "review" completed
    }
    gate "You sign off the review" type="human" {
      reviewer "person/ada"
      question "Is this review ready to share?"
    }
  }
}
