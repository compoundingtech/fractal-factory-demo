// A flaky test needs a reliable repair.
// Three setups try the same task and tests.
// A judge checks the ranked comparison report.
version 2
mission "eval-flaky-test" state="ready" \
    timeout="20m" report-to="agent/eval-judge" {
  goal "One report compares every setup's fix."
  constraint "Never disable harness features to pass."
  // The same task and tests make repairs comparable
  step "codex" timeout="10m" {
    assigned-to "agent/codex-contender"
    goal "Fix the flaky test in acme/app."
    gate "the suite passes" {
      exec "pnpm test"
      host "local"
      workspace "/work/eval/codex"
      time-limit "5m"
    }
  }
  step "claude" timeout="10m" {
    assigned-to "agent/claude-contender"
    goal "Fix the flaky test in acme/app."
    gate "the suite passes" {
      exec "pnpm test"
      host "local"
      workspace "/work/eval/claude"
      time-limit "5m"
    }
  }
  step "candidate" timeout="10m" {
    assigned-to "agent/candidate-contender"
    goal "Fix the flaky test in acme/app."
    gate "the suite passes" {
      exec "pnpm test"
      host "local"
      workspace "/work/eval/candidate"
      time-limit "5m"
    }
  }
  // Ranking needs results from all three setups
  step "compare" timeout="5m" {
    assigned-to "agent/eval-judge"
    depends-on {
      step "codex" completed
      step "claude" completed
      step "candidate" completed
    }
    goal "Rank the repairs using diffs and test runs."
    gate "report published" {
      document "doc/eval/flaky-test/report"
    }
    // A separate check keeps the ranking fair
    gate "the report is fair" type="llm" {
      model "gpt-5.6-sol"
      host "local"
      workspace "/work/eval"
      tools "shell" "git"
      token-budget 20000
      time-limit "4m"
      prompt "Is the report fair to each diff?"
    }
  }
}
