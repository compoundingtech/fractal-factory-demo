// A comments feature is ready to build.
// API and platform developers build it together.
// Tests pass, then you decide whether to release.
version 2
mission "ship-comments" state="ready" \
    timeout="5d" report-to="agent/qa-tester" {
  goal "Comments work on web, iOS and Android."
  constraint "One spec everywhere, no platform extras."
  // A shared API keeps platform behavior consistent
  step "api" timeout="1d" {
    assigned-to "agent/api-dev"
    goal "The API serves the shared schema."
    gate "api" {
      ci-passed "api" repo="acme/app" branch="comments"
    }
  }
  // Each platform needs the same working API
  step "web" timeout="2d" {
    assigned-to "agent/web-dev"
    depends-on {
      step "api" completed
    }
    goal "Comments work on the web."
    gate "web-e2e" {
      ci-passed "web-e2e" repo="acme/app" \
          branch="comments"
    }
  }
  step "ios" timeout="2d" {
    assigned-to "agent/ios-dev"
    depends-on {
      step "api" completed
    }
    goal "Comments work on iOS."
    gate "ios-e2e" {
      ci-passed "ios-e2e" repo="acme/app" \
          branch="comments"
    }
  }
  step "android" timeout="2d" {
    assigned-to "agent/android-dev"
    depends-on {
      step "api" completed
    }
    goal "Comments work on Android."
    gate "android-e2e" {
      ci-passed "android-e2e" repo="acme/app" \
          branch="comments"
    }
  }
  // Shared tests catch differences across platforms
  step "parity" timeout="2h" {
    assigned-to "agent/qa-tester"
    depends-on {
      step "web" completed
      step "ios" completed
      step "android" completed
    }
    goal "Each platform passes the same suite."
    gate "parity" {
      exec "pnpm test:parity"
      host "local"
      workspace "/work/app"
    }
  }
  // Passing tests do not grant release approval
  step "approve" {
    depends-on {
      step "parity" completed
    }
    gate "You approve the release" type="human" {
      reviewer "person/you"
      question "Ship comments on every platform?"
    }
  }
}
