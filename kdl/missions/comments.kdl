// Ship comments on every platform from one API.
version 2
mission "collab/comments" state="ready" \
    timeout="5d" report-to="agent/collab/qa" {
  goal "Comments work on web, iOS and Android."
  constraint "One spec everywhere, no platform extras."
  step "api" timeout="1d" {
    assigned-to "agent/collab/api"
    goal "The API serves the shared schema."
    gate "api" {
      ci-passed "api" repo="acme/app" branch="comments"
    }
  }
  // Platforms start together once the API passed
  step "web" timeout="2d" {
    assigned-to "agent/collab/web"
    depends-on {
      step "api" completed
    }
    goal "Comments work on the web."
    gate "web-e2e" {
      ci-passed "web-e2e" repo="acme/app" \
          branch="comments"
    }
  }
  step "ios" timeout="2d" {
    assigned-to "agent/collab/ios"
    depends-on {
      step "api" completed
    }
    goal "Comments work on iOS."
    gate "ios-e2e" {
      ci-passed "ios-e2e" repo="acme/app" \
          branch="comments"
    }
  }
  step "android" timeout="2d" {
    assigned-to "agent/collab/android"
    depends-on {
      step "api" completed
    }
    goal "Comments work on Android."
    gate "android-e2e" {
      ci-passed "android-e2e" repo="acme/app" \
          branch="comments"
    }
  }
  // One scenario suite, run against every platform
  step "parity" timeout="2h" {
    assigned-to "agent/collab/qa"
    depends-on {
      step "web" completed
      step "ios" completed
      step "android" completed
    }
    goal "Each platform passes the same suite."
    gate "parity" {
      exec "pnpm test:parity"
      host "local"
      workspace "/work/app"
    }
  }
  // No agent here, the step waits for a person
  step "approve" {
    agentless
    depends-on {
      step "parity" completed
    }
    gate "You approve the release" type="human" {
      reviewer "person/ada"
      question "Ship comments on every platform?"
    }
  }
}
