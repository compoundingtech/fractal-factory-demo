// Remove the week's worst factory friction.
version 2
mission "factory/self-improve" state="ready" \
    timeout="2d" report-to="agent/factory/steward" {
  goal "The week's worst friction is gone."
  constraint "Only edit declarations. Keep every gate."
  step "failures" timeout="30m" {
    assigned-to "agent/factory/analyst"
    goal "List failed runs, stuck gates."
    gate "failures published" {
      document "doc/factory/failures"
    }
  }
  step "asks" timeout="30m" {
    assigned-to "agent/factory/steward"
    goal "List asks and their wait times."
    gate "asks published" {
      document "doc/factory/asks"
    }
  }
  // The change must replay last week's failures
  step "propose" timeout="2h" {
    assigned-to "agent/factory/steward"
    depends-on {
      step "failures" completed
      step "asks" completed
    }
    goal "One PR changes one declaration."
    gate "the replays pass" {
      exec "./scripts/replay.sh doc/factory/failures"
      host "local"
      workspace "/work/factory"
      time-limit "30m"
    }
  }
  // Nothing is applied before a person says yes
  step "approve" {
    agentless
    depends-on {
      step "propose" completed
    }
    gate "You approve the change" type="human" {
      reviewer "person/ada"
      question "Apply the improved declarations?"
    }
  }
  step "apply" timeout="30m" {
    assigned-to "agent/factory/steward"
    depends-on {
      step "approve" completed
    }
    goal "Merge it, then run fractal apply."
    gate "CI passed on main" {
      ci-passed "ci" repo="acme/factory" branch="main"
    }
  }
}
