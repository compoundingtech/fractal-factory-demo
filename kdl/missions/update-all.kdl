// Keep every repo on current dependencies.
version 2
mission "deps/update-all" state="ready" \
    timeout="2h" report-to="agent/app/maintainer" {
  goal "Every repo runs current deps, CI green."
  constraint "No major bumps without a migration note."
  // One maintainer per repo, all at once
  step "app" timeout="1h" {
    assigned-to "agent/app/maintainer"
    goal "A green deps PR in acme/app."
    // CI, not the agent, says a repo is done
    gate "CI passed" {
      ci-passed "ci" repo="acme/app" \
          branch="deps/update"
    }
  }
  step "api" timeout="1h" {
    assigned-to "agent/api/maintainer"
    goal "A green deps PR in acme/api."
    gate "CI passed" {
      ci-passed "ci" repo="acme/api" \
          branch="deps/update"
    }
  }
  step "docs" timeout="1h" {
    assigned-to "agent/docs/maintainer"
    goal "A green deps PR in acme/docs."
    gate "CI passed" {
      ci-passed "ci" repo="acme/docs" \
          branch="deps/update"
    }
  }
  // Starts once every repo passed its gate
  step "report" timeout="15m" {
    assigned-to "agent/app/maintainer"
    depends-on {
      step "app" completed
      step "api" completed
      step "docs" completed
    }
    goal "A report links each PR and CI run."
    gate "report published" {
      document "doc/deps/report"
    }
  }
}
