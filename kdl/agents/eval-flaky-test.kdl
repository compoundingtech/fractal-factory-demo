// One contender per setup, and the reporter.
version 2
agent "eval/codex" {
  lifecycle "bounded"
  host "local"
  workspace "/work/eval/codex"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "medium"
  }
}
agent "eval/claude" {
  lifecycle "bounded"
  host "local"
  workspace "/work/eval/claude"
  harness "claude" {
    model "claude-opus-5"
    effort "medium"
  }
}
agent "eval/candidate" {
  lifecycle "bounded"
  host "local"
  workspace "/work/eval/candidate"
  // The setup under test, swapped per eval run
  harness "opencode" {
    model "kimi-k3"
  }
}
agent "eval/reporter" {
  lifecycle "standing"
  host "local"
  workspace "/work/eval"
  harness "claude" {
    model "claude-opus-5"
    effort "high"
  }
}
