version 2
// Repairs the flaky test with the Codex setup
agent "codex-contender" {
  lifecycle "bounded"
  host "local"
  workspace "/work/eval/codex"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "medium"
  }
}
// Repairs the flaky test with the Claude setup
agent "claude-contender" {
  lifecycle "bounded"
  host "local"
  workspace "/work/eval/claude"
  harness "claude" {
    model "claude-opus-5"
    effort "medium"
  }
}
// Repairs the flaky test with the candidate setup
agent "candidate-contender" {
  lifecycle "bounded"
  host "local"
  workspace "/work/eval/candidate"
  // This setup changes between comparison runs
  harness "opencode" {
    model "kimi-k3"
  }
}
// Compares the repairs and publishes a ranked report
agent "eval-judge" {
  lifecycle "standing"
  host "local"
  workspace "/work/eval"
  harness "claude" {
    model "claude-opus-5"
    effort "high"
  }
}
