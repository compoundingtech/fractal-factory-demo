// One agent per part, and the person who approves.
version 2
agent "collab/api" {
  lifecycle "standing"
  host "local"
  workspace "/work/app"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
agent "collab/web" {
  lifecycle "standing"
  host "local"
  workspace "/work/app"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
agent "collab/ios" {
  lifecycle "standing"
  host "local"
  workspace "/work/app"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
agent "collab/android" {
  lifecycle "standing"
  host "local"
  workspace "/work/app"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
agent "collab/qa" {
  lifecycle "standing"
  host "local"
  workspace "/work/app"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
person "ada"
