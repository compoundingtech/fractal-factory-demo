version 2
// Runs the pull request tests
agent "pr-tester" {
  lifecycle "standing"
  host "local"
  workspace "/work/review"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "medium"
  }
}
// Reviews the pull request with test evidence
agent "pr-reviewer" {
  lifecycle "standing"
  host "local"
  workspace "/work/review"
  // Review decisions use high effort
  harness "claude" {
    model "claude-opus-5"
    effort "high"
  }
}
person "you"
