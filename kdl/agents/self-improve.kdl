// Analyst, steward and the person who approves.
version 2
agent "factory/analyst" {
  lifecycle "standing"
  host "local"
  workspace "/work/factory"
  harness "claude" {
    model "claude-opus-5"
    effort "medium"
  }
}
agent "factory/steward" {
  lifecycle "standing"
  host "local"
  workspace "/work/factory"
  // It edits the factory itself, so it reasons hardest
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
person "ada"
