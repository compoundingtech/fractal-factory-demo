// Tester, reviewer and the person who signs off.
version 2
agent "github/tester" {
  lifecycle "standing"
  host "local"
  workspace "/work/review"
  harness "codex" {
    model "gpt-5.6-sol"
    effort "medium"
  }
}
agent "github/reviewer" {
  lifecycle "standing"
  host "local"
  workspace "/work/review"
  // Judgment work gets the stronger setting
  harness "claude" {
    model "claude-opus-5"
    effort "high"
  }
}
person "ada"
