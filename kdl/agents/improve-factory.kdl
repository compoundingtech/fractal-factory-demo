version 2
// Finds problems in failed factory runs
agent "run-analyst" {
  lifecycle "standing"
  host "local"
  workspace "/work/factory"
  harness "claude" {
    model "claude-opus-5"
    effort "medium"
  }
}
// Tests and applies an approved factory change
agent "factory-editor" {
  lifecycle "standing"
  host "local"
  workspace "/work/factory"
  // Factory changes use high effort
  harness "codex" {
    model "gpt-5.6-sol"
    effort "high"
  }
}
person "you"
